---
import { site } from "../config/site";

interface Props {
  class?: string;
  variant?: "platform" | "maintainer";
}

const { class: className = "", variant = "platform" } = Astro.props;

const platformLinks = [
  { href: site.platform.github, label: "GitHub", external: true },
  {
    href: `mailto:${site.platform.contactEmail}`,
    label: "Email",
    external: false,
  },
];

const maintainerLinks = [
  { href: site.maintainer.github, label: "GitHub", external: true },
  { href: site.maintainer.linkedin, label: "LinkedIn", external: true },
  {
    href: `mailto:${site.maintainer.email}`,
    label: "Email",
    external: false,
  },
];

const links = variant === "maintainer" ? maintainerLinks : platformLinks;
---

<ul class:list={["flex flex-wrap gap-3 text-xs sm:text-sm", className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class="text-blue-700 hover:text-blue-900 hover:underline"
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
