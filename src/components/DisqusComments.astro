---
import { site } from "../config/site";
import { getDisqusPageConfig } from "../lib/disqus";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

if (!site.disqus.enabled || !site.disqus.shortname) {
  return null;
}

const { pageUrl, pageIdentifier } = getDisqusPageConfig(slug);
const { shortname } = site.disqus;
---

<section
  class="disqus-comments mt-12 border-t border-slate-200 pt-8"
  aria-labelledby="comments-heading"
>
  <h2 id="comments-heading" class="mb-4 text-lg font-semibold text-slate-900">
    Comments
  </h2>
  <div id="disqus_thread">
    <button
      type="button"
      id="disqus-load-btn"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-blue-300 hover:text-blue-700"
    >
      Load comments
    </button>
  </div>
  <p id="disqus-status" class="mt-3 hidden text-sm text-slate-500" aria-live="polite"></p>
  <noscript>
    <p class="text-sm text-slate-600">
      Please enable JavaScript to view comments powered by Disqus.
    </p>
  </noscript>
  <p class="mt-3 text-xs text-slate-500">
    Comments are hosted by
    <a
      href="https://disqus.com"
      class="text-blue-700 hover:underline"
      target="_blank"
      rel="noopener noreferrer">Disqus</a
    >. The free tier may show sponsored content.
  </p>
</section>

<script is:inline define:vars={{ pageUrl, pageIdentifier, shortname }}>
  function patchGetComputedStyleForDisqus() {
    if (window.__disqusStylePatch) return;
    window.__disqusStylePatch = true;

    var original = window.getComputedStyle;
    window.getComputedStyle = function (element, pseudoElt) {
      var styles = original.call(window, element, pseudoElt);

      function sanitizeColor(value, property) {
        if (typeof value !== "string" || value.indexOf("oklch") === -1) {
          return value;
        }
        if (property && property.indexOf("background") !== -1) return "#ffffff";
        if (property && property.indexOf("border") !== -1) return "#e2e8f0";
        return "#1e293b";
      }

      return new Proxy(styles, {
        get: function (target, prop) {
          if (prop === "getPropertyValue") {
            return function (property) {
              return sanitizeColor(target.getPropertyValue(property), property);
            };
          }

          var value = target[prop];
          if (typeof value === "string") {
            return sanitizeColor(value, String(prop));
          }
          if (typeof value === "function") {
            return value.bind(target);
          }
          return value;
        },
      });
    };
  }

  var disqus_config = function () {
    this.page.url = pageUrl;
    this.page.identifier = pageIdentifier;
  };

  function setDisqusStatus(message) {
    var status = document.getElementById("disqus-status");
    if (!status) return;
    status.textContent = message;
    status.classList.remove("hidden");
  }

  function loadDisqusEmbed() {
    var holder = document.getElementById("disqus_thread");
    if (!holder || holder.dataset.disqusLoaded === "true") return;

    patchGetComputedStyleForDisqus();
    holder.innerHTML = "";
    setDisqusStatus("Loading comments…");

    var script = document.createElement("script");
    script.src = "https://" + shortname + ".disqus.com/embed.js";
    script.setAttribute("data-timestamp", String(+new Date()));
    script.async = true;
    script.onload = function () {
      var status = document.getElementById("disqus-status");
      status?.classList.add("hidden");
    };
    script.onerror = function () {
      setDisqusStatus(
        "Comments could not load. Try disabling ad blockers or test on the live site after deploy."
      );
    };
    (document.head || document.body).appendChild(script);
    holder.dataset.disqusLoaded = "true";
  }

  function setupDisqus() {
    var holder = document.getElementById("disqus_thread");
    if (!holder || holder.dataset.disqusLoaded === "true") return;

    if (window.location.hash === "#disqus_thread") {
      loadDisqusEmbed();
      return;
    }

    var button = document.getElementById("disqus-load-btn");
    if (button) {
      button.addEventListener("click", loadDisqusEmbed);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupDisqus);
  } else {
    setupDisqus();
  }

  window.addEventListener("hashchange", function () {
    if (window.location.hash === "#disqus_thread") {
      loadDisqusEmbed();
      document.getElementById("disqus_thread")?.scrollIntoView({ behavior: "smooth" });
    }
  });
</script>
