---
import { site } from "../config/site";
import ContactLinks from "./ContactLinks.astro";
---

<footer class="site-footer border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
    <ContactLinks class="mb-1.5 text-slate-500" variant="platform" />
    <p class="text-xs text-slate-500">
      © {site.copyrightYear} {site.brand}
      <a
        href="/credits/"
        class="credits-easter-egg mx-0.5 text-slate-400 hover:text-slate-600 focus:text-slate-600 focus:outline-none"
        aria-label="Credits"
        title="Credits"
      >·</a>
      {site.footerTagline}.
    </p>
  </div>
</footer>

<style>
  .credits-easter-egg {
    text-decoration: none;
  }
</style>
