---
import { site } from "../config/site";
import SearchBar from "./react/SearchBar";
import AuthMenu from "./react/AuthMenu";

const nav = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/resume/", label: "Resume" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="group leading-tight shrink-0">
        <span class="text-base font-semibold text-slate-900 group-hover:text-blue-700">
          {site.brand}
        </span>
        <span class="block text-[11px] text-slate-500">{site.tagline}</span>
      </a>
      <div class="sm:hidden">
        <AuthMenu client:load />
      </div>
    </div>
    <div class="flex flex-1 flex-col gap-3 sm:flex-row sm:items-center sm:justify-end">
      <SearchBar client:load />
      <nav aria-label="Main" class="shrink-0">
        <ul class="flex flex-wrap gap-3 text-xs font-medium sm:text-sm">
          {
            nav.map((item) => {
              const isActive =
                item.href === "/"
                  ? currentPath === "/"
                  : currentPath.startsWith(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "hover:text-blue-700",
                      isActive ? "text-blue-700" : "text-slate-600",
                    ]}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <div class="hidden sm:block">
        <AuthMenu client:load />
      </div>
    </div>
  </div>
</header>
