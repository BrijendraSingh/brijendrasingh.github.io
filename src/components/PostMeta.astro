---
interface Props {
  pubDate: Date;
  tags?: string[];
}

const { pubDate, tags = [] } = Astro.props;

const formatted = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
  <time datetime={pubDate.toISOString()}>{formatted}</time>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <span class="rounded-full bg-slate-200 px-2.5 py-0.5 text-xs text-slate-700">
              {tag}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</div>
