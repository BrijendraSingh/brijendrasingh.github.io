---
import { formatTagLabel } from "../lib/blog";

interface Props {
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  readingTime?: number;
}

const { pubDate, updatedDate, tags = [], readingTime } = Astro.props;

const published = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const updated =
  updatedDate &&
  updatedDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<aside class="post-sidebar" aria-label="Article details">
  <nav class="post-sidebar-nav">
    <a href="/blog/" class="post-sidebar-back">← All articles</a>
  </nav>

  <dl class="post-sidebar-meta">
    <div>
      <dt>Published</dt>
      <dd>
        <time datetime={pubDate.toISOString()}>{published}</time>
      </dd>
    </div>
    {
      updated && updated !== published && (
        <div>
          <dt>Updated</dt>
          <dd>
            <time datetime={updatedDate!.toISOString()}>{updated}</time>
          </dd>
        </div>
      )
    }
    {
      readingTime && (
        <div>
          <dt>Reading time</dt>
          <dd>{readingTime} min</dd>
        </div>
      )
    }
    {
      tags.length > 0 && (
        <div>
          <dt>Topics</dt>
          <dd>
            <ul class="post-sidebar-tags">
              {tags.map((tag) => (
                <li>{formatTagLabel(tag)}</li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>

  <p class="post-sidebar-subscribe">
    <a href="/rss.xml">Subscribe via RSS</a>
  </p>
</aside>
