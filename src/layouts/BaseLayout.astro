---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import HashScrollManager from "../components/react/HashScrollManager";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  layout?: "default" | "article";
  robots?: string;
}

const { title, description, type, layout = "default", robots } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
    <title>{title ? `${title} | ${site.brand}` : site.brand}</title>
    {robots && <meta name="robots" content={robots} />}
    <SEO title={title ?? site.brand} description={description ?? site.description} type={type} />
  </head>
  <body class="site-shell">
    <Header />
    <main class="site-main w-full">
      <div
        class:list={[
          "mx-auto w-full px-4 py-10 sm:px-6 lg:px-8",
          layout === "article" ? "max-w-7xl" : "max-w-6xl",
        ]}
      >
        <slot />
      </div>
    </main>
    <Footer />
    <HashScrollManager client:load />
  </body>
</html>
