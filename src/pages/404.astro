---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="py-16 text-center">
    <p class="text-6xl font-bold text-slate-300">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-slate-900">Page not found</h1>
    <p class="mt-2 text-slate-600">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-6 inline-block text-blue-700 hover:underline">← Back to home</a>
  </div>
</BaseLayout>
