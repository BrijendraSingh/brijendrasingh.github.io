---
import { marked } from "marked";
import PostLayout from "../../layouts/PostLayout.astro";
import { getPostBySlug } from "../../lib/server/posts";

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/blog/");

const post = await getPostBySlug(slug);
if (!post) return Astro.redirect("/404");

const html = marked.parse(post.body_md, { async: false }) as string;
const pubDate = new Date(post.published_at || post.pub_date || post.created_at);
const updatedDate = post.updated_date ? new Date(post.updated_date) : undefined;
const tags = post.tags?.map((t) => t.slug) ?? [];
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  slug={post.slug}
  commentsDisable={Boolean(post.comments_disabled)}
  readingTime={post.reading_time ?? undefined}
  postId={post.id}
>
  <div set:html={html} />
</PostLayout>
