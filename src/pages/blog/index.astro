---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import DisqusCountScript from "../../components/DisqusCountScript.astro";
import { getPublishedPosts, postHref } from "../../lib/blog";

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Articles on software quality, test strategy, and automation by Brijendra Singh."
>
  <h1 class="text-3xl font-bold text-slate-900">Blog</h1>
  <p class="mt-2 text-slate-600">
    Practical software quality practices from 14+ years in the industry.
  </p>

  {
    posts.length === 0 ? (
      <p class="mt-10 text-slate-500">No posts yet. Check back soon.</p>
    ) : (
      <div class="mt-10 grid gap-6">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            href={postHref(post.id)}
            slug={post.id}
          />
        ))}
      </div>
    )
  }
  <DisqusCountScript />
</BaseLayout>
