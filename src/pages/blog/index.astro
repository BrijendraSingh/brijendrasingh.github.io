---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveSidebar from "../../components/ArchiveSidebar.astro";
import BlogFilterSidebar from "../../components/BlogFilterSidebar.astro";
import BlogListItem from "../../components/BlogListItem.astro";
import {
  BLOG_CATEGORIES,
  BLOG_TYPES,
  getMatchingGroupIds,
} from "../../lib/blog-filters";
import { getPublishedPosts, postHref, estimateReadingTime } from "../../lib/blog";

const searchQuery = Astro.url.searchParams.get("q") ?? "";
const posts = await getPublishedPosts();
const filtered = searchQuery
  ? posts.filter(
      (p) =>
        p.data.title.toLowerCase().includes(searchQuery.toLowerCase()) ||
        p.data.description.toLowerCase().includes(searchQuery.toLowerCase())
    )
  : posts;
---

<BaseLayout
  title="Blog"
  description="Articles on software quality, test strategy, and automation by Brijendra Singh."
  layout="article"
>
  <div class="blog-page">
    {searchQuery && (
      <p class="mb-4 text-sm text-slate-600">
        Showing results for &ldquo;{searchQuery}&rdquo; ({filtered.length})
      </p>
    )}
    <div class="blog-list-layout">
      {
        filtered.length > 0 && (
          <div class="blog-filters-column">
            <BlogFilterSidebar posts={filtered} />
          </div>
        )
      }

      <div class="blog-primary">
        {
          filtered.length === 0 ? (
            <p class="blog-page-empty">No posts yet. Check back soon.</p>
          ) : (
            <div class="blog-feed" role="feed" data-blog-feed>
              <p class="blog-filter-empty" data-blog-empty hidden>
                No articles match the selected filters.
              </p>
              {filtered.map((post) => (
                <BlogListItem
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  href={postHref(post.id)}
                  slug={post.id}
                  readingTime={estimateReadingTime(post.body ?? "")}
                  filterTypes={getMatchingGroupIds(post.data.tags, BLOG_TYPES).join(",")}
                  filterCategories={getMatchingGroupIds(post.data.tags, BLOG_CATEGORIES).join(",")}
                />
              ))}
            </div>
          )
        }
      </div>

      {
        filtered.length > 0 && (
          <div class="blog-sidebar-column">
            <ArchiveSidebar posts={filtered} />
          </div>
        )
      }
    </div>

    {
      filtered.length > 0 && (
        <div class="blog-archive-mobile">
          <ArchiveSidebar posts={filtered} />
        </div>
      )
    }
  </div>
</BaseLayout>
