---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchiveSidebar from "../components/ArchiveSidebar.astro";
import BlogListItem from "../components/BlogListItem.astro";
import { site } from "../config/site";
import { getPublishedPosts, postHref, estimateReadingTime } from "../lib/blog";

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);

const valueProps = [
  {
    title: "Read",
    description: "Curated articles on test strategy, automation, and quality culture.",
  },
  {
    title: "Discuss",
    description: "Comments and reader reactions on every published article.",
  },
  {
    title: "Write",
    description: "Sign in, draft your article, and submit it for community review.",
  },
];
---

<BaseLayout layout="article">
  <div class="home-page">
    <div class="blog-layout">
      <div class="blog-primary">
        <section class="py-6">
          <p class="text-sm font-medium uppercase tracking-wide text-blue-700">
            Community blog
          </p>
          <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            {site.brand}
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-slate-600">
            {site.description}
          </p>
          {
            posts.length > 0 && (
              <p class="mt-3 text-sm text-slate-500">
                {posts.length} {posts.length === 1 ? "article" : "articles"} · Open to contributors
              </p>
            )
          }
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/blog/"
              class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800"
            >
              Explore articles
            </a>
            <a
              href="/auth/signin"
              class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 hover:border-blue-300 hover:text-blue-700"
            >
              Contribute an article
            </a>
          </div>
        </section>

        <section class="mt-10 grid gap-4 sm:grid-cols-3">
          {
            valueProps.map((item) => (
              <div class="rounded-lg border border-slate-200 bg-white px-4 py-4">
                <h2 class="text-sm font-semibold text-slate-900">{item.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
              </div>
            ))
          }
        </section>

        {
          latestPosts.length > 0 && (
            <section class="mt-16">
              <div class="mb-2 flex items-baseline justify-between gap-4">
                <h2 class="text-xl font-semibold text-slate-900">Latest articles</h2>
                <a href="/blog/" class="shrink-0 text-sm text-blue-700 hover:underline">
                  View all
                </a>
              </div>
              <div class="blog-feed blog-feed--compact" role="feed">
                {latestPosts.map((post) => (
                  <BlogListItem
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    tags={post.data.tags}
                    href={postHref(post.id)}
                    slug={post.id}
                    readingTime={estimateReadingTime(post.body ?? "")}
                  />
                ))}
              </div>
            </section>
          )
        }
      </div>

      {
        posts.length > 0 && (
          <div class="blog-sidebar-column">
            <ArchiveSidebar posts={posts} />
          </div>
        )
      }
    </div>

    {
      posts.length > 0 && (
        <div class="blog-archive-mobile">
          <ArchiveSidebar posts={posts} />
        </div>
      )
    }
  </div>
</BaseLayout>
