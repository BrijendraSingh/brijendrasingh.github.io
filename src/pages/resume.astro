---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { site } from "../config/site";
---

<BaseLayout title="Resume" description={`Resume of ${site.name} — ${site.tagline}`}>
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4 print:hidden">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">{site.name}</h1>
      <p class="mt-1 text-lg text-slate-600">{site.tagline}</p>
    </div>
    <a
      href="/resume.pdf"
      download="Brijendra-Singh-Resume.pdf"
      class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800"
    >
      Download PDF
    </a>
  </div>

  <div class="resume-content space-y-10 text-slate-700">
    <section>
      <h2 class="text-xl font-semibold text-slate-900">Summary</h2>
      <p class="mt-3 leading-relaxed">
        Software quality practitioner with 14+ years in the software industry. Quality
        analyst by profession and quality enthusiast by practice — experienced in test
        strategy, automation at scale, mobile and microservices testing, and building a
        defect-prevention mindset across engineering teams.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-slate-900">Core expertise</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">
        <li>Test strategy & test pyramid design</li>
        <li>Test automation (UI, API, component)</li>
        <li>Mobile application testing</li>
        <li>Microservices & contract testing</li>
        <li>CI/CD quality gates & shift-left practices</li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-slate-900">Experience</h2>
      <div class="mt-4 space-y-6">
        <div>
          <p class="font-medium text-slate-900">Quality Consultant / QA Practitioner</p>
          <p class="text-slate-600">Thoughtworks, India</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed">
            <li>
              Led test strategy and automation initiatives across mobile, microservices,
              and enterprise integration projects.
            </li>
            <li>
              Championed component testing and test pyramid practices to reduce late-stage
              defects and testing bottlenecks.
            </li>
            <li>
              Partnered with engineering teams on CI/CD quality gates, engineered test data,
              and sustainable automation frameworks.
            </li>
          </ul>
        </div>
        <p class="text-sm text-slate-500">
          Additional experience spans 14+ years in software quality across product and
          consulting engagements. Update role dates and earlier positions in
          <code class="rounded bg-slate-200 px-1">src/pages/resume.astro</code> as needed.
        </p>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-slate-900">Skills</h2>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <div>
          <h3 class="font-medium text-slate-800">Testing</h3>
          <p class="text-sm leading-relaxed">
            Test strategy, exploratory testing, mobile QA, API testing, microservices
            testing, defect prevention
          </p>
        </div>
        <div>
          <h3 class="font-medium text-slate-800">Automation & tools</h3>
          <p class="text-sm leading-relaxed">
            UI & API automation, component tests, Detox (mobile), CI/CD integration,
            test data engineering
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-slate-900">Writing & community</h2>
      <p class="mt-3 text-sm leading-relaxed">
        Author of <a href="/blog/" class="text-blue-700 hover:underline">{site.brand}</a>
        — articles on test strategy, automation layers, mobile testing, and software
        quality practices from real-world experience.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-slate-900">Contact</h2>
      <ContactLinks class="mt-3" />
    </section>
  </div>
</BaseLayout>

<style>
  @media print {
    :global(header),
    :global(footer) {
      display: none !important;
    }
    :global(main) {
      max-width: 100% !important;
      padding: 0 !important;
    }
    .resume-content {
      color: #1e293b;
    }
  }
</style>
